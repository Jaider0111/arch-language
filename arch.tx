// Metamodel (M2) of the architecture description language of the SoS
// Adapted from Laboratory 4 (ERTMS) for the Caribbean Port Management System (CPMS).
//
// Adaptations with respect to Laboratory 4 (marked [A1]..[A4]):
//   [A1] Identifiers keep the notation of Deliveries 1 and 2 (T2.1, A-K70, SoS-K12a, A-K85').
//   [A2] Components and connectors may carry capacity and load (events or requests
//        per second); components may carry a number of active instances; new metric
//        'utilization' (A-QS4, A-QS6).
//   [A3] A factor of an analysis may carry its own value (a stage budget or a
//        scenario-specific availability), so the same element can appear in two
//        scenarios with different budgets (SoS-QS1: M3 and M4).
//   [A4] A factor may be a redundant element with n replicas and a common-cause
//        fraction (T2.1, T2.5, T3.6, T3.9 in Delivery 2, L16), without duplicating
//        the element in the structure.

Model:
    'system' name=ID
    constituents+=Constituent
    elements+=Element
    analyses*=Analysis
;

Constituent:
    'constituent' name=ID label=STRING 'owner' owner=STRING
;

Element:
    Component | Connector
;

Component:
    'component' name=Ident label=STRING
        'in' system=[Constituent]
        'tier' tier=Tier
        'kind' kind=Kind
        ('availability' availability=NUMBER)?
        ('latency' latency=NUMBER)?
        ('capacity' capacity=NUMBER)?
        ('load' load=NUMBER)?
        ('instances' instances=INT)?
;

Connector:
    'connector' name=Ident
        'nature' natures+=Nature[',']
        'coupling' coupling=Coupling
        'carries' info=STRING
        ('agreement' agreement=STRING)?
        ('availability' availability=NUMBER)?
        ('latency' latency=NUMBER)?
        ('capacity' capacity=NUMBER)?
        ('load' load=NUMBER)?
        ':' links+=Link[',']
;

Link:
    path+=[Component|Ident]['->']
;

Analysis:
    'analysis' name=Ident 'scenario' scenario=STRING
        metric=Metric 'target' target=NUMBER ':'
        factors+=Factor[',']
;

Factor:
    Group | Replicated | Single
;

Single:
    ref=[Element|Ident] ('value' value=NUMBER)?
;

Replicated:
    ref=[Component|Ident] 'replicas' count=INT 'beta' beta=NUMBER
;

Group:
    '[' alternatives+=[Element|Ident]['|'] ']' 'beta' beta=NUMBER
;

// Identifier of Deliveries 1 and 2: letters and digits, with '.' or '-' inside and an optional prime.
Ident:  /[A-Za-z][A-Za-z0-9_]*([.\-][A-Za-z0-9_]+)*'?/;

Tier:       'T1' | 'T2' | 'T3' | 'T4' | 'T5';
Kind:       'hardware_software' | 'hardware' | 'software' | 'physical';
Nature:     'data_flow' | 'control_command' | 'dependency' | 'event_notification';
Coupling:   'blocking' | 'supply' | 'sink';
Metric:     'availability' | 'latency' | 'utilization';

Comment:
    /\/\/.*$/
;
